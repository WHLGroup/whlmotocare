# Copy to .env for local development. Never commit the real .env file.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local:      postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production: use your provider's POOLED connection string (it usually has
#             "-pooler" or "pgbouncer=true" in it) and keep sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Private, single-use owner enrollment key for first-time /admin setup.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave blank locally and `npm run bootstrap` will create one for you.
# Never expose this value in client code, screenshots or version control.
ADMIN_SETUP_KEY=

# ── Recommended ──────────────────────────────────────────────────────────────

# Public address of the site, used for link previews (WhatsApp, Facebook),
# the sitemap and robots.txt. Set this once you have a custom domain.
# On Vercel it falls back to the deployment URL automatically, so it is only
# strictly needed when you attach your own domain.
# NEXT_PUBLIC_SITE_URL=https://whlmotocare.com

# ── Optional ─────────────────────────────────────────────────────────────────

# Direct (non-pooled) connection string, used only for schema changes.
# Some providers require this because PgBouncer cannot run every migration
# statement. If unset, DATABASE_URL is used.
# DIRECT_DATABASE_URL=

# Maximum PostgreSQL connections per serverless instance. Defaults to 3.
# Lower it if your database has a small connection limit.
# DATABASE_POOL_MAX=3
